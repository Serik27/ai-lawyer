# Ключ для Google Gemini API
GOOGLE_API_KEY=your_gemini_api_key_here

# Токен Telegram бота від BotFather
BOT_TOKEN=your_telegram_bot_token_here

# Юзернейм бота (без @) для лінків на сайті
TELEGRAM_BOT_USERNAME=your_bot_username

# ID адміністраторів через кому
ADMIN_IDS=123456789

# Рядок підключення до PostgreSQL (pgvector)
DATABASE_URL=postgresql+psycopg2://postgres:my_secret_pass_123@localhost:5433/law_db

# Порт веб-сервера (за замовчуванням 8080)
WEB_PORT=8080
WEB_HOST=0.0.0.0
